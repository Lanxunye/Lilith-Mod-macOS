{
  "name": "lilith-dsh-desktop-bridge",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "莉莉丝统一会话：DSH 桌面端续聊、历史回写与本地文件同步",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js"
  },
  "files": [
    "index.mjs",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "test": "node --test test.mjs"
  },
  "license": "MIT"
}
